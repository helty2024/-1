.ui-loading {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
}

.ui-loading__spinner {
  box-sizing: border-box;
  border-radius: 50%;
  border: 4rpx solid rgba(160, 122, 36, 0.28);
  border-top-color: #caa34c;
  animation: ui-loading-spin 0.8s linear infinite;
}

.ui-loading__text {
  color: #f3ecd9;
  font-size: 24rpx;
}

@keyframes ui-loading-spin {
  to {
    transform: rotate(360deg);
  }
}
