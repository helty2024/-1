.ui-stepper {
  display: inline-flex;
  align-items: center;
  border: 1px solid rgba(201, 165, 73, 0.45);
  border-radius: 10rpx;
  overflow: hidden;
}

.ui-stepper__btn,
.ui-stepper__input {
  height: 54rpx;
  line-height: 54rpx;
  box-sizing: border-box;
}

.ui-stepper__btn {
  width: 54rpx;
  text-align: center;
  color: #f5e8c8;
  background: rgba(255, 255, 255, 0.02);
}

.ui-stepper__input {
  width: 64rpx;
  padding: 0;
  border: 0;
  text-align: center;
  color: #fff;
  background: transparent;
}
