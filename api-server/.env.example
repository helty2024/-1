NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
ADMIN_WEB_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true

DATABASE_URL=mysql://zhishentang:zhishentang_local@127.0.0.1:3307/zhishentang
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=zhishentang
DATABASE_PASSWORD=zhishentang_local
DATABASE_NAME=zhishentang
DATABASE_CONNECTION_LIMIT=10
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=true

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6380

# Nginx 位于 API 前方时保留 1；API 直接暴露公网时设为 0。
TRUST_PROXY_HOPS=1
# 公共表单防刷：同一 IP 10 分钟最多 20 次，同一表单最多 6 次。
PUBLIC_FORM_RATE_WINDOW_SECONDS=600
PUBLIC_FORM_RATE_IP_MAX=20
PUBLIC_FORM_RATE_FORM_IP_MAX=6
PUBLIC_FORM_MAX_BODY_BYTES=32768
PUBLIC_FORM_ALLOWED_SOURCES=wechat_miniprogram,web

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=2h
APP_DATA_ENCRYPTION_KEY=replace-with-another-32-character-secret

# 本地开发使用 local；正式环境可改为 cos。
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_DIR=storage/media
MEDIA_TEMP_DIR=storage/tmp/media
MEDIA_MAX_FILE_SIZE_BYTES=20971520
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media

# MEDIA_STORAGE_DRIVER=cos 时以下四项必填。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 可填绑定到 COS 的自定义 CDN/域名；留空时使用腾讯云 COS 默认域名。
COS_PUBLIC_BASE_URL=

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=ChangeMe_2026!
ADMIN_SEED_DISPLAY_NAME=超级管理员

LOG_LEVEL=debug
LOG_PRETTY=true
