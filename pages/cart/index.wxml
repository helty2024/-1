<view class="page">
  <view class="hero">
    <image class="hero-bg" src="{{content.coverImage || '/images/brand/strength-bg.jpg'}}" mode="aspectFill" />
    <view class="hero-overlay"></view>
    <view class="hero-content">
      <view class="eyebrow">{{content.label}}</view>
      <view class="brand">{{content.title}}</view>
      <view class="subtitle">{{content.subtitle}}</view>
      <view class="hero-stats">
        <view class="stat" wx:for="{{content.stats}}" wx:key="label">
          <text class="stat-value">{{item.value}}</text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{evidenceSection}}">
    <view class="section-head">
      <text class="section-title">{{evidenceSection.title}}</text>
      <text class="section-sub">{{evidenceSection.body}}</text>
    </view>
    <view class="proof-grid">
      <view class="proof-card" wx:for="{{evidenceSection.cards}}" wx:key="title">
        <text class="proof-title">{{item.title}}</text>
        <text class="proof-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{gallerySection && galleryCards.length}}">
    <view class="section-head">
      <text class="section-title">{{gallerySection.title}}</text>
      <text class="section-sub">{{gallerySection.body}}</text>
    </view>
    <view class="image-strip">
      <view
        class="strip-card {{item.url ? 'is-interactive' : 'is-readonly'}}"
        hover-class="interactive-hover"
        wx:for="{{galleryCards}}"
        wx:key="title"
        data-url="{{item.url}}"
        data-tab="{{item.tab}}"
        bindtap="handleAction"
      >
        <image class="strip-image" src="{{item.image}}" mode="aspectFill" />
        <view class="strip-copy" wx:if="{{item.title || item.desc}}">
          <text class="strip-title">{{item.title}}</text>
          <text class="strip-desc">{{item.desc}}</text>
          <text class="strip-action" wx:if="{{item.url}}">{{item.actionText || '查看详情'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{ctaSection}}">
    <view class="cta-card">
      <view class="cta-copy">
        <text class="cta-title">{{ctaSection.title}}</text>
        <text class="cta-desc">{{ctaSection.body}}</text>
      </view>
      <view class="cta-actions">
        <button
          wx:if="{{content.primaryAction}}"
          class="btn btn-primary"
          data-url="{{content.primaryAction.url}}"
          data-tab="{{content.primaryAction.tab}}"
          bindtap="handleAction"
        >{{content.primaryAction.text}}</button>
        <button
          wx:if="{{content.secondaryAction}}"
          class="btn btn-ghost"
          data-url="{{content.secondaryAction.url}}"
          data-tab="{{content.secondaryAction.tab}}"
          bindtap="handleAction"
        >{{content.secondaryAction.text}}</button>
      </view>
    </view>
  </view>
</view>
