.page {
  box-sizing: border-box;
  background: #f4efe6;
  color: #1f1a16;
  padding-bottom: calc(env(safe-area-inset-bottom) + 110rpx);
}

.page {
  min-height: 100vh;
}

.hero {
  position: relative;
  overflow: hidden;
  min-height: 900rpx;
  padding: 36rpx 28rpx 40rpx;
  color: #fff7e8;
  background: #1f160e;
}

.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  filter: brightness(1.06) saturate(1.03);
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(24, 16, 10, 0.12) 0%, rgba(24, 16, 10, 0.42) 58%, rgba(24, 16, 10, 0.68) 100%),
    linear-gradient(135deg, rgba(133, 83, 33, 0.1) 0%, rgba(47, 30, 18, 0.03) 48%, rgba(17, 12, 9, 0.36) 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
  padding-top: 120rpx;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border: 1px solid rgba(231, 192, 104, 0.58);
  border-radius: 999rpx;
  background: rgba(255, 240, 214, 0.08);
  font-size: 22rpx;
  text-shadow: 0 2rpx 8rpx rgba(18, 12, 8, 0.28);
}

.brand {
  margin-top: 28rpx;
  font-size: 72rpx;
  line-height: 1;
  font-weight: 700;
  text-shadow: 0 4rpx 16rpx rgba(18, 12, 8, 0.34);
}

.subtitle {
  margin-top: 18rpx;
  max-width: 620rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: rgba(255, 246, 229, 0.88);
  text-shadow: 0 3rpx 12rpx rgba(18, 12, 8, 0.32);
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 30rpx;
}

.stat {
  min-height: 120rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 247, 235, 0.11);
  border: 1px solid rgba(231, 192, 104, 0.45);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-value {
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 700;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 246, 229, 0.76);
}

.btn {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  border: 0;
  font-size: 28rpx;
  font-weight: 600;
}

.btn::after {
  border: 0;
}

.btn-primary {
  color: #1c120a;
  background: linear-gradient(135deg, #f3c97a 0%, #f9e6bf 100%);
}

.btn-ghost {
  color: #fff7e8;
  background: rgba(255, 247, 235, 0.08);
  border: 1px solid rgba(231, 192, 104, 0.52);
}

.section {
  padding: 28rpx 24rpx 0;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #201812;
}

.section-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6f6257;
}

.proof-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.proof-card,
.cta-card {
  border-radius: 22rpx;
  background: #fff;
  border: 1px solid rgba(231, 192, 104, 0.38);
  box-shadow: 0 18rpx 50rpx rgba(33, 24, 15, 0.05);
}

.proof-card {
  padding: 18rpx;
}

.proof-title,
.cta-title {
  display: block;
  font-weight: 700;
  color: #22180f;
  font-size: 30rpx;
}

.proof-desc,
.cta-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6d5f55;
}

.image-strip {
  display: grid;
  gap: 14rpx;
}

.strip-card {
  overflow: hidden;
  border: 1px solid rgba(190, 201, 214, 0.48);
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.045));
}

.strip-image {
  width: 100%;
  height: 240rpx;
  display: block;
}

.strip-copy {
  padding: 16rpx 18rpx 18rpx;
}

.strip-title,
.strip-desc,
.strip-action,
.detail-action {
  display: block;
}

.strip-title {
  font-size: 27rpx;
  line-height: 1.3;
  font-weight: 700;
}

.strip-desc {
  margin-top: 7rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.72);
}

.strip-action {
  margin-top: 14rpx;
  color: #efc769;
  font-size: 22rpx;
  font-weight: 700;
  text-align: right;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.trust-tag {
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1px solid rgba(231, 192, 104, 0.38);
  color: #5f4f45;
  font-size: 24rpx;
}

.cta-card {
  padding: 22rpx;
  margin-bottom: 24rpx;
}

.cta-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

@media screen and (min-width: 760px) {
  .hero,
  .section {
    padding-left: 40rpx;
    padding-right: 40rpx;
  }

  .hero-stats {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .proof-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .image-strip {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

.page {
  background: #050403;
  color: #fff;
}

.page {
  color: #fff;
  background:
    radial-gradient(circle at 12% 0%, rgba(225, 178, 87, 0.13), transparent 32%),
    linear-gradient(180deg, #0b0906 0%, #050403 50%, #090806 100%);
}

.hero {
  background: #050403;
}

.hero-bg {
  filter: brightness(0.94) saturate(1.04);
}

.hero-overlay {
  background:
    linear-gradient(180deg, rgba(5, 4, 3, 0.18) 0%, rgba(5, 4, 3, 0.46) 58%, rgba(5, 4, 3, 0.82) 100%),
    linear-gradient(135deg, rgba(214, 171, 83, 0.18) 0%, rgba(5, 4, 3, 0.1) 48%, rgba(5, 4, 3, 0.48) 100%);
}

.eyebrow,
.stat {
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(231, 192, 104, 0.28);
}

.section-title,
.proof-title,
.cta-title,
.stat-value {
  color: #fff;
}

.subtitle,
.section-sub,
.proof-desc,
.cta-desc,
.stat-label {
  color: rgba(255, 255, 255, 0.78);
}

.proof-card,
.cta-card,
.trust-tag {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.045));
  border-color: rgba(231, 192, 104, 0.22);
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.28);
}

.trust-tag {
  color: #fff;
}

.btn-primary {
  color: #fff;
  background: linear-gradient(135deg, #8a5d20 0%, #d3ad5d 52%, #8f6226 100%);
  box-shadow: 0 12rpx 30rpx rgba(194, 145, 55, 0.22);
}

.btn-ghost {
  color: #fff;
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(231, 192, 104, 0.28);
}

.eyebrow,
.stat,
.proof-card,
.cta-card,
.trust-tag,
.strip-card,
.btn {
  border-color: rgba(231, 192, 104, 0.58);
}

.btn,
.strip-card {
  border-width: 1px;
  border-style: solid;
}

.hero-bg {
  filter: blur(1.1rpx) brightness(1.0) contrast(1.05) saturate(0.97);
  transform: scale(1.03);
  transform-origin: center center;
  opacity: 0.96;
}

.hero-overlay {
  background:
    linear-gradient(180deg, rgba(5, 4, 3, 0.12) 0%, rgba(5, 4, 3, 0.38) 58%, rgba(5, 4, 3, 0.74) 100%),
    linear-gradient(135deg, rgba(214, 171, 83, 0.14) 0%, rgba(5, 4, 3, 0.08) 48%, rgba(5, 4, 3, 0.42) 100%);
}

.detail-grid {
  display: grid;
  gap: 14rpx;
}

.detail-card {
  padding: 18rpx;
  border: 1px solid rgba(190, 201, 214, 0.48);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.045));
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.22);
}

.detail-title,
.detail-desc {
  display: block;
}

.detail-action {
  margin-top: 14rpx;
  color: #efc769;
  font-size: 22rpx;
  font-weight: 700;
  text-align: right;
}

.detail-title {
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 700;
}

.detail-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.72);
}

/* Gold marks actions; silver marks read-only information. */
.eyebrow,
.stat,
.proof-card,
.cta-card,
.trust-tag,
.strip-card {
  border-color: rgba(190, 201, 214, 0.48);
}

.strip-card.is-interactive,
.detail-card.is-interactive,
.btn {
  border-color: rgba(239, 199, 105, 0.92);
  border-width: 2rpx;
  border-style: solid;
  box-shadow: 0 0 0 1rpx rgba(239, 199, 105, 0.08), 0 16rpx 38rpx rgba(184, 128, 37, 0.16);
}
