<view class="page">
  <view class="hero">
    <image class="hero-bg" src="{{heroImage}}" mode="aspectFill" />
    <view class="hero-overlay"></view>
    <view class="hero-content">
      <view class="eyebrow">{{pageContent.label}}</view>
      <view class="brand">
        <text class="brand-line" wx:for="{{titleLines}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="subtitle">{{pageContent.subtitle}}</view>
      <view class="hero-stats">
        <view class="stat" wx:for="{{heroStats}}" wx:key="label">
          <text class="stat-value">{{item.value}}</text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{productIntroSection}}">
    <view class="section-head">
      <text class="section-title">{{productIntroSection.title}}</text>
      <text class="section-sub">{{productIntroSection.body}}</text>
    </view>
    <view class="product-grid">
      <view class="product-card" hover-class="interactive-hover" wx:for="{{products}}" wx:key="slug" data-slug="{{item.slug}}" bindtap="openProduct">
        <image class="product-image" src="{{item.image}}" mode="aspectFill" />
        <view class="product-body">
          <view class="product-topline">
            <text class="product-name">{{item.name}}</text>
            <text class="product-role">{{item.role}}</text>
          </view>
          <text class="product-note">{{item.note}}</text>
          <text class="product-scene">{{item.scene}}</text>
          <view class="product-link">查看产品招商详情</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{scenarioSection}}">
    <view class="section-head">
      <text class="section-title">{{scenarioSection.title}}</text>
      <text class="section-sub">{{scenarioSection.body}}</text>
    </view>
    <view class="scenario-grid">
      <view class="scenario-card" wx:for="{{scenarioSection.cards}}" wx:key="title">
        <text class="scenario-title">{{item.title}}</text>
        <text class="scenario-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{ctaSection}}">
    <view class="cta-card">
      <view class="cta-copy">
        <text class="cta-title">{{ctaSection.title}}</text>
        <text class="cta-desc">{{ctaSection.body}}</text>
      </view>
      <view class="cta-actions">
        <button
          class="btn btn-primary"
          wx:if="{{ctaSection.actionText}}"
          data-url="{{ctaSection.actionUrl}}"
          data-tab="{{ctaSection.actionTab}}"
          bindtap="handleAction"
        >{{ctaSection.actionText}}</button>
        <button
          class="btn btn-ghost"
          wx:if="{{ctaSection.secondaryActionText}}"
          data-url="{{ctaSection.secondaryActionUrl}}"
          data-tab="{{ctaSection.secondaryActionTab}}"
          bindtap="handleAction"
        >{{ctaSection.secondaryActionText}}</button>
      </view>
    </view>
  </view>
</view>
