page {
  box-sizing: border-box;
  background: #f4efe6;
  color: #1f1a16;
  padding-bottom: calc(env(safe-area-inset-bottom) + 110rpx);
}

.page {
  min-height: 100vh;
}

.hero {
  position: relative;
  overflow: hidden;
  min-height: 1080rpx;
  padding: 36rpx 28rpx 40rpx;
  color: #fff7e8;
  background: #1f160e;
}

.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  filter: brightness(1.08) saturate(1.04);
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(24, 16, 10, 0.08) 0%, rgba(24, 16, 10, 0.32) 58%, rgba(24, 16, 10, 0.58) 100%),
    linear-gradient(135deg, rgba(133, 83, 33, 0.08) 0%, rgba(47, 30, 18, 0.02) 48%, rgba(17, 12, 9, 0.28) 100%);
}

.hero-content,
.hero-panel {
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border: 1px solid rgba(231, 192, 104, 0.58);
  border-radius: 999rpx;
  background: rgba(255, 240, 214, 0.08);
  font-size: 22rpx;
  letter-spacing: 0;
  text-shadow: 0 2rpx 8rpx rgba(18, 12, 8, 0.28);
}

.brand {
  margin-top: 28rpx;
  font-size: 72rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0;
  text-shadow: 0 4rpx 16rpx rgba(18, 12, 8, 0.34);
}

.subtitle {
  margin-top: 18rpx;
  max-width: 620rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: rgba(255, 246, 229, 0.88);
  text-shadow: 0 3rpx 12rpx rgba(18, 12, 8, 0.32);
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 30rpx;
}

.stat {
  min-height: 120rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 247, 235, 0.11);
  border: 1px solid rgba(231, 192, 104, 0.45);
  backdrop-filter: blur(6px);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-value {
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 700;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 246, 229, 0.76);
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  border: 0;
  font-size: 28rpx;
  font-weight: 600;
}

.btn::after,
.wide-btn::after {
  border: 0;
}

.btn-primary {
  color: #1c120a;
  background: linear-gradient(135deg, #f3c97a 0%, #f9e6bf 100%);
}

.btn-ghost {
  color: #fff7e8;
  background: rgba(255, 247, 235, 0.08);
  border: 1px solid rgba(231, 192, 104, 0.52);
}

.hero-panel {
  display: grid;
  grid-template-columns: 162rpx 1fr;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 247, 235, 0.12);
  border: 1px solid rgba(231, 192, 104, 0.45);
}

.panel-image {
  width: 162rpx;
  height: 180rpx;
  border-radius: 16rpx;
}

.panel-body {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
}

.panel-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 246, 229, 0.82);
}

.section {
  padding: 28rpx 24rpx 0;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #201812;
}

.section-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6f6257;
}

.trust-grid,
.product-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.trust-card,
.product-card,
.evidence-card,
.step-card,
.cta-card {
  border-radius: 22rpx;
  background: #fff;
  border: 1px solid rgba(231, 192, 104, 0.38);
  box-shadow: 0 18rpx 50rpx rgba(33, 24, 15, 0.05);
}

.trust-card {
  overflow: hidden;
}

.trust-image {
  width: 100%;
  height: 260rpx;
  display: block;
}

.trust-body {
  padding: 18rpx;
}

.trust-title,
.product-name,
.evidence-title,
.step-title,
.cta-title {
  display: block;
  font-weight: 700;
  color: #22180f;
}

.trust-title {
  font-size: 30rpx;
}

.trust-desc,
.product-note,
.evidence-desc,
.step-desc,
.cta-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6d5f55;
}

.evidence-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.evidence-card {
  padding: 18rpx;
}

.evidence-no {
  display: block;
  font-size: 22rpx;
  color: #8a6a35;
  font-weight: 700;
}

.evidence-title {
  margin-top: 10rpx;
  font-size: 28rpx;
}

.evidence-desc {
  font-size: 22rpx;
}

.evidence-visual {
  margin-top: 16rpx;
  border-radius: 22rpx;
  overflow: hidden;
}

.evidence-img {
  width: 100%;
  height: 320rpx;
  display: block;
}

.product-card {
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 240rpx;
  display: block;
}

.product-body {
  padding: 16rpx;
}

.product-name {
  font-size: 30rpx;
}

.wide-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
  border: 0;
  font-size: 28rpx;
  color: #fff7e8;
  background: linear-gradient(135deg, #2f1d12 0%, #5e3a20 100%);
}

.step-list {
  display: grid;
  gap: 14rpx;
}

.step-card {
  display: grid;
  grid-template-columns: 92rpx 1fr;
  gap: 14rpx;
  align-items: center;
  padding: 18rpx;
}

.step-no {
  width: 92rpx;
  height: 92rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f4e2bc 0%, #d9bc84 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3b2715;
  font-size: 30rpx;
  font-weight: 700;
}

.step-copy {
  min-width: 0;
}

.cta-card {
  padding: 22rpx;
  margin-bottom: 24rpx;
}

.cta-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

@media screen and (min-width: 760px) {
  .hero,
  .section {
    padding-left: 40rpx;
    padding-right: 40rpx;
  }

  .hero {
    min-height: 860rpx;
  }

  .hero-stats {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .trust-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .evidence-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

page {
  background: #050403;
  color: #fff;
}

.page,
.page view,
.page text,
.page button {
  color: #fff;
}

.page {
  background:
    radial-gradient(circle at 12% 0%, rgba(225, 178, 87, 0.14), transparent 34%),
    linear-gradient(180deg, #0b0906 0%, #050403 48%, #090806 100%);
}

.hero {
  background: #050403;
}

.hero-bg {
  filter: brightness(0.96) saturate(1.05);
}

.hero-overlay {
  background:
    linear-gradient(180deg, rgba(5, 4, 3, 0.18) 0%, rgba(5, 4, 3, 0.42) 58%, rgba(5, 4, 3, 0.78) 100%),
    linear-gradient(135deg, rgba(214, 171, 83, 0.18) 0%, rgba(5, 4, 3, 0.1) 48%, rgba(5, 4, 3, 0.46) 100%);
}

.eyebrow,
.stat,
.hero-panel {
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(231, 192, 104, 0.28);
}

.section-title,
.trust-title,
.product-name,
.evidence-title,
.step-title,
.cta-title,
.stat-value,
.panel-title {
  color: #fff;
}

.subtitle,
.section-sub,
.trust-desc,
.product-note,
.evidence-desc,
.step-desc,
.cta-desc,
.stat-label,
.panel-desc {
  color: rgba(255, 255, 255, 0.78);
}

.trust-card,
.product-card,
.evidence-card,
.step-card,
.cta-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.045));
  border-color: rgba(231, 192, 104, 0.22);
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.28);
}

.trust-body,
.product-body,
.evidence-card,
.step-card,
.cta-card {
  background: transparent;
}

.evidence-no,
.step-no {
  color: #fff;
}

.step-no {
  background: linear-gradient(135deg, #9b6a23 0%, #e0bd6d 100%);
}

.btn-primary,
.wide-btn {
  color: #fff;
  background: linear-gradient(135deg, #8a5d20 0%, #d3ad5d 52%, #8f6226 100%);
  box-shadow: 0 12rpx 30rpx rgba(194, 145, 55, 0.22);
}

.btn-ghost {
  color: #fff;
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(231, 192, 104, 0.28);
}

.eyebrow,
.stat,
.hero-panel,
.trust-card,
.product-card,
.evidence-card,
.step-card,
.cta-card,
.btn,
.wide-btn,
.evidence-visual {
  border-color: rgba(231, 192, 104, 0.58);
}

.btn,
.wide-btn,
.evidence-visual {
  border-width: 1px;
  border-style: solid;
}

.hero-bg {
  filter: brightness(1.16) saturate(1.06);
}

.hero-overlay {
  background:
    linear-gradient(180deg, rgba(5, 4, 3, 0.12) 0%, rgba(5, 4, 3, 0.34) 58%, rgba(5, 4, 3, 0.72) 100%),
    linear-gradient(135deg, rgba(214, 171, 83, 0.16) 0%, rgba(5, 4, 3, 0.08) 48%, rgba(5, 4, 3, 0.42) 100%);
}

.official-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.official-card {
  min-height: 188rpx;
  padding: 18rpx;
  border: 1px solid rgba(231, 192, 104, 0.58);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.045));
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.24);
}

.official-title,
.official-desc,
.official-link {
  display: block;
}

.official-title {
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #fff;
}

.official-desc {
  margin-top: 8rpx;
  min-height: 68rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.72);
}

.official-link {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #f2cf83;
}

