<view class="page">
  <view class="hero">
    <image class="hero-bg" src="{{heroImage}}" mode="aspectFill" />
    <view class="hero-overlay"></view>
    <view class="hero-content">
      <view class="eyebrow">{{homeContent.label}}</view>
      <view class="brand">{{homeContent.title}}</view>
      <view class="subtitle">{{homeContent.subtitle}}</view>
      <view class="hero-stats">
        <view class="stat" wx:for="{{homeContent.stats}}" wx:key="label">
          <text class="stat-value">{{item.value}}</text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="company-panel" wx:if="{{companySection}}">
      <image class="company-panel-image" src="{{companySection.image}}" mode="aspectFill" />
      <view class="company-panel-body">
        <view class="company-panel-title">{{companySection.title}}</view>
        <view class="company-panel-desc">{{companySection.body}}</view>
      </view>
    </view>

    <view class="hero-panel interactive-panel" hover-class="interactive-hover" bindtap="openCeoProfile">
      <image class="panel-image" src="{{ceoCard.coverImage}}" mode="aspectFit" />
      <view class="panel-body">
        <view class="panel-title">{{ceoCard.title}}</view>
        <view class="panel-desc">{{ceoCard.subtitle}}</view>
        <view class="panel-link" wx:if="{{ceoCard.actionText}}">{{ceoCard.actionText}}</view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{navigationSection}}">
    <view class="section-head">
      <text class="section-title">{{navigationSection.title}}</text>
      <text class="section-sub">{{navigationSection.body}}</text>
    </view>
    <view class="official-grid">
      <view
        class="official-card"
        hover-class="interactive-hover"
        wx:for="{{navigationSection.cards}}"
        wx:key="title"
        data-url="{{item.url}}"
        data-tab="{{item.tab}}"
        bindtap="handleAction"
      >
        <text class="official-title">{{item.title}}</text>
        <text class="official-desc">{{item.desc}}</text>
        <text class="official-link" wx:if="{{item.actionText}}">{{item.actionText}}</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{productSection}}">
    <view class="section-head">
      <text class="section-title">{{productSection.title}}</text>
      <text class="section-sub">{{productSection.body}}</text>
    </view>
    <image
      wx:if="{{productSection.image}}"
      class="product-section-image"
      src="{{productSection.image}}"
      mode="aspectFill"
    />
    <block wx:if="{{showHomeProducts}}">
      <view class="product-grid">
        <view
          class="product-card interactive-panel"
          hover-class="interactive-hover"
          wx:for="{{products}}"
          wx:key="slug"
          data-slug="{{item.slug}}"
          bindtap="openProduct"
        >
          <image class="product-image" src="{{item.image}}" mode="aspectFill" />
          <view class="product-body">
            <text class="product-name">{{item.shortName || item.name}}</text>
            <text class="product-note">{{item.note}}</text>
            <text class="product-link">查看产品 ›</text>
          </view>
        </view>
      </view>
    </block>
    <button
      class="wide-btn"
      wx:if="{{productAction.text}}"
      data-url="{{productAction.url}}"
      data-tab="{{productAction.tab}}"
      bindtap="handleAction"
    >{{productAction.text}}</button>
  </view>

  <view class="section" wx:if="{{stepsSection}}">
    <view class="section-head">
      <text class="section-title">{{stepsSection.title}}</text>
      <text class="section-sub">{{stepsSection.body}}</text>
    </view>
    <view class="step-list">
      <view class="step-card" wx:for="{{stepsSection.cards}}" wx:key="title">
        <text class="step-no">0{{index + 1}}</text>
        <view class="step-copy">
          <text class="step-title">{{item.title}}</text>
          <text class="step-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{ctaSection}}">
    <view class="cta-card">
      <view class="cta-copy">
        <text class="cta-title">{{ctaSection.title}}</text>
        <text class="cta-desc">{{ctaSection.body}}</text>
      </view>
      <view class="cta-actions">
        <button
          class="btn btn-primary"
          wx:if="{{homeContent.primaryAction}}"
          data-url="{{homeContent.primaryAction.url}}"
          data-tab="{{homeContent.primaryAction.tab}}"
          bindtap="handleAction"
        >{{homeContent.primaryAction.text}}</button>
        <button
          class="btn btn-ghost"
          wx:if="{{homeContent.secondaryAction}}"
          data-url="{{homeContent.secondaryAction.url}}"
          data-tab="{{homeContent.secondaryAction.tab}}"
          bindtap="handleAction"
        >{{homeContent.secondaryAction.text}}</button>
      </view>
    </view>
  </view>
</view>
