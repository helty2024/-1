page {
  background: #050403;
  color: #fff;
  padding-bottom: calc(env(safe-area-inset-bottom) + 128rpx);
}

.page,
.page view,
.page text,
.page button {
  box-sizing: border-box;
  color: #fff;
}

.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 14% 0%, rgba(216, 174, 87, 0.16), transparent 34%),
    linear-gradient(180deg, #0b0906 0%, #050403 54%, #090806 100%);
}

.hero {
  padding: 42rpx 28rpx 28rpx;
}

.hero-image {
  width: 100%;
  height: 440rpx;
  margin-bottom: 28rpx;
  border: 1px solid rgba(190, 201, 214, 0.48);
  border-radius: 20rpx;
}

.loading-state {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
}

.eyebrow {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border: 1px solid rgba(231, 192, 104, 0.66);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  font-size: 22rpx;
}

.title {
  margin-top: 28rpx;
  font-size: 56rpx;
  line-height: 1.12;
  font-weight: 700;
}

.subtitle {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.78);
}

.stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 28rpx;
}

.stat,
.info-card,
.faq-item,
.timeline-item {
  border: 1px solid rgba(231, 192, 104, 0.58);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.045));
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.28);
}

.stat {
  min-height: 118rpx;
  padding: 18rpx;
  border-radius: 18rpx;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  line-height: 1.1;
  font-weight: 700;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.section {
  padding: 28rpx 24rpx 0;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
}

.section-body {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.62;
  color: rgba(255, 255, 255, 0.76);
}

.section-image {
  display: block;
  width: 100%;
  height: 360rpx;
  margin-bottom: 18rpx;
  border: 1px solid rgba(190, 201, 214, 0.48);
  border-radius: 20rpx;
}

.card-grid,
.faq-list,
.timeline {
  display: grid;
  gap: 16rpx;
}

.info-card,
.faq-item,
.timeline-item {
  border-radius: 20rpx;
  padding: 20rpx;
}

.info-card {
  overflow: hidden;
}

.interactive-info-card {
  border-color: rgba(239, 199, 105, 0.92);
  border-width: 2rpx;
  box-shadow: 0 0 0 1rpx rgba(239, 199, 105, 0.08), 0 14rpx 34rpx rgba(184, 128, 37, 0.16);
}

.card-image {
  display: block;
  width: calc(100% + 40rpx);
  height: 300rpx;
  margin: -20rpx -20rpx 20rpx;
}

.card-title,
.faq-q,
.timeline-year {
  display: block;
  font-size: 29rpx;
  line-height: 1.3;
  font-weight: 700;
}

.card-desc,
.faq-a,
.timeline-text {
  display: block;
  margin-top: 9rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: rgba(255, 255, 255, 0.74);
}

.card-file {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1px solid rgba(239, 199, 105, 0.24);
}

.card-file-icon {
  flex: 0 0 auto;
  padding: 5rpx 8rpx;
  border: 1px solid rgba(239, 199, 105, 0.72);
  color: #efc769;
  font-size: 18rpx;
  font-weight: 700;
}

.card-file-name {
  min-width: 0;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-action {
  display: block;
  margin-top: 16rpx;
  color: #efc769;
  font-size: 23rpx;
  font-weight: 700;
  text-align: right;
}

.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: rgba(5, 4, 3, 0.92);
  border-top: 1px solid rgba(231, 192, 104, 0.42);
}

.action-primary,
.action-ghost {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  border: 1px solid rgba(231, 192, 104, 0.66);
  font-size: 27rpx;
  font-weight: 700;
}

.action-primary::after,
.action-ghost::after {
  border: 0;
}

.action-primary {
  background: linear-gradient(135deg, #8a5d20 0%, #d3ad5d 52%, #8f6226 100%);
}

.action-ghost {
  background: rgba(255, 255, 255, 0.06);
}

/* Gold marks actions; silver marks read-only information. */
.eyebrow,
.stat,
.faq-item,
.timeline-item {
  border-color: rgba(190, 201, 214, 0.48);
}

.info-card:not(.interactive-info-card) {
  border-color: rgba(190, 201, 214, 0.48);
}

.action-primary,
.action-ghost {
  border-color: rgba(239, 199, 105, 0.92);
  border-width: 2rpx;
  box-shadow: 0 0 0 1rpx rgba(239, 199, 105, 0.08), 0 14rpx 34rpx rgba(184, 128, 37, 0.16);
}
