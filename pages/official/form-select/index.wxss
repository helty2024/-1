page {
  background: #050403;
  color: #fff;
}

.page,
.page view,
.page text,
.page button {
  box-sizing: border-box;
  color: #fff;
}

.page {
  min-height: 100vh;
  padding: 42rpx 24rpx calc(env(safe-area-inset-bottom) + 48rpx);
  background: #050403;
}

.page-head {
  display: flex;
  flex-direction: column;
  padding: 0 4rpx 32rpx;
}

.eyebrow {
  color: #d9b768;
  font-size: 22rpx;
}

.title {
  margin-top: 14rpx;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 700;
}

.subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 26rpx;
  line-height: 1.6;
}

.form-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.form-item {
  min-height: 176rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 26rpx 24rpx;
  border: 1px solid rgba(225, 187, 98, 0.68);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.055);
}

.form-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.form-name {
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 700;
}

.form-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  line-height: 1.55;
}

.form-meta {
  margin-top: 14rpx;
  color: #d9b768;
  font-size: 21rpx;
}

.form-arrow {
  flex: 0 0 36rpx;
  color: #d9b768;
  font-size: 52rpx;
  line-height: 1;
  text-align: center;
}

.state {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 44rpx 28rpx;
  border: 1px solid rgba(225, 187, 98, 0.5);
  text-align: center;
}

.state-title {
  font-size: 30rpx;
  font-weight: 700;
}

.state-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.64);
  font-size: 24rpx;
  line-height: 1.6;
}

.retry-btn {
  min-width: 220rpx;
  margin-top: 28rpx;
  border: 1px solid #d9b768;
  border-radius: 10rpx;
  background: #936525;
  font-size: 25rpx;
}

.retry-btn::after {
  border: 0;
}

/* Gold marks actions; silver marks read-only information. */
.state {
  border-color: rgba(190, 201, 214, 0.48);
}

.form-item,
.retry-btn {
  border-color: rgba(239, 199, 105, 0.92);
  border-width: 2rpx;
  box-shadow: 0 0 0 1rpx rgba(239, 199, 105, 0.08), 0 16rpx 38rpx rgba(184, 128, 37, 0.16);
}
