<view class="page">
  <view class="page-head">
    <text class="eyebrow">合作申请</text>
    <text class="title">选择{{typeLabel}}表单</text>
    <text class="subtitle">请选择与你合作意向对应的申请项目。</text>
  </view>

  <view class="state" wx:if="{{loading}}">
    <text class="state-title">正在加载</text>
    <text class="state-desc">正在获取最新申请项目...</text>
  </view>

  <view class="state" wx:elif="{{loadError}}">
    <text class="state-title">加载失败</text>
    <text class="state-desc">{{loadError}}</text>
    <button class="retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <view class="form-list" wx:elif="{{forms.length}}">
    <view
      class="form-item"
      hover-class="interactive-hover"
      wx:for="{{forms}}"
      wx:key="code"
      data-code="{{item.code}}"
      bindtap="openForm"
    >
      <view class="form-copy">
        <text class="form-name">{{item.title}}</text>
        <text class="form-desc">{{item.subtitle || item.name}}</text>
        <text class="form-meta">{{item.fieldCount}} 项填写内容</text>
      </view>
      <text class="form-arrow">›</text>
    </view>
  </view>

  <view class="state" wx:else>
    <text class="state-title">暂无可填写表单</text>
    <text class="state-desc">当前暂无开放的{{typeLabel}}项目，请稍后再试。</text>
  </view>
</view>
