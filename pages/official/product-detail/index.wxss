page {
  background: #050403;
  color: #fff;
  padding-bottom: calc(env(safe-area-inset-bottom) + 132rpx);
}

.page,
.page view,
.page text,
.page button {
  box-sizing: border-box;
  color: #fff;
}

.hero {
  position: relative;
  min-height: 720rpx;
  overflow: hidden;
  background: #050403;
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  filter: brightness(0.78) saturate(1.02);
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(5, 4, 3, 0.1) 0%, rgba(5, 4, 3, 0.38) 48%, rgba(5, 4, 3, 0.92) 100%),
    linear-gradient(135deg, rgba(190, 143, 53, 0.2) 0%, rgba(5, 4, 3, 0.08) 58%, rgba(5, 4, 3, 0.52) 100%);
}

.hero-copy {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 44rpx;
}

.eyebrow {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border: 1px solid rgba(231, 192, 104, 0.58);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  font-size: 22rpx;
  line-height: 1.3;
}

.title {
  margin-top: 26rpx;
  font-size: 62rpx;
  line-height: 1.08;
  font-weight: 700;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.8);
}

.section {
  padding: 28rpx 24rpx 0;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
}

.copy-card,
.point-card,
.split-card,
.spec-card,
.value-card,
.notice-card {
  border: 1px solid rgba(231, 192, 104, 0.58);
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.045));
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.28);
}

.copy-card {
  padding: 22rpx;
  font-size: 26rpx;
  line-height: 1.65;
}

.point-list,
.value-list {
  display: grid;
  gap: 14rpx;
}

.point-card {
  display: grid;
  grid-template-columns: 72rpx 1fr;
  gap: 16rpx;
  align-items: flex-start;
  padding: 20rpx;
}

.point-no {
  font-size: 24rpx;
  font-weight: 700;
  color: #e2bd67;
}

.point-text,
.split-desc,
.spec-value,
.value-card,
.notice-desc {
  font-size: 25rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.78);
}

.evidence-intro,
.evidence-no,
.evidence-title,
.evidence-desc {
  display: block;
}

.evidence-intro {
  font-size: 25rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.78);
}

.evidence-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 26rpx;
}

.evidence-item {
  padding: 0;
}

.evidence-no {
  color: rgba(255, 255, 255, 0.56);
  font-size: 22rpx;
  font-weight: 700;
}

.evidence-title {
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.evidence-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.76);
}

.evidence-image {
  width: 100%;
  height: 360rpx;
  margin-top: 26rpx;
  border: 1px solid rgba(190, 201, 214, 0.48);
  border-radius: 22rpx;
}

.image-section {
  padding-top: 24rpx;
}

.wide-image {
  width: 100%;
  height: 360rpx;
  border: 1px solid rgba(231, 192, 104, 0.58);
  border-radius: 22rpx;
  display: block;
}

.split-card {
  display: grid;
  gap: 18rpx;
  padding: 22rpx;
}

.split-title,
.notice-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.spec-card {
  overflow: hidden;
}

.spec-row {
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  border-bottom: 1px solid rgba(231, 192, 104, 0.24);
}

.spec-row:last-child {
  border-bottom: 0;
}

.spec-label {
  font-size: 24rpx;
  color: #e2bd67;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  padding: 12rpx 16rpx;
  border: 1px solid rgba(231, 192, 104, 0.58);
  border-radius: 999rpx;
  background: rgba(214, 171, 83, 0.12);
  font-size: 24rpx;
}

.value-card {
  padding: 20rpx 22rpx;
}

.notice-card {
  padding: 20rpx 22rpx;
  margin-bottom: 24rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: rgba(5, 4, 3, 0.94);
  border-top: 1px solid rgba(231, 192, 104, 0.36);
}

.action-primary,
.action-ghost {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  border: 1px solid rgba(231, 192, 104, 0.58);
  font-size: 28rpx;
  font-weight: 600;
}

.action-primary::after,
.action-ghost::after {
  border: 0;
}

.action-primary {
  background: linear-gradient(135deg, #8a5d20 0%, #d3ad5d 52%, #8f6226 100%);
}

.action-ghost {
  background: rgba(255, 255, 255, 0.06);
}

/* Gold marks actions; silver marks read-only information. */
.eyebrow,
.copy-card,
.point-card,
.split-card,
.spec-card,
.value-card,
.notice-card,
.wide-image,
.tag {
  border-color: rgba(190, 201, 214, 0.48);
}

.spec-row {
  border-bottom-color: rgba(190, 201, 214, 0.24);
}

.action-primary,
.action-ghost {
  border-color: rgba(239, 199, 105, 0.92);
  border-width: 2rpx;
  box-shadow: 0 0 0 1rpx rgba(239, 199, 105, 0.08), 0 14rpx 34rpx rgba(184, 128, 37, 0.16);
}
