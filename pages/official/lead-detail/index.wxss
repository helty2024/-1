page {
  background: #050403;
  color: #fff;
  padding-bottom: calc(env(safe-area-inset-bottom) + 42rpx);
}

.page,
.page view,
.page text,
.page textarea,
.page button {
  box-sizing: border-box;
  color: #fff;
}

.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 14% 0%, rgba(216, 174, 87, 0.16), transparent 34%),
    linear-gradient(180deg, #0b0906 0%, #050403 54%, #090806 100%);
}

.hero {
  padding: 42rpx 28rpx 24rpx;
}

.eyebrow {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border: 1px solid rgba(231, 192, 104, 0.66);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  font-size: 22rpx;
}

.title {
  margin-top: 28rpx;
  font-size: 52rpx;
  line-height: 1.14;
  font-weight: 700;
}

.subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.72);
}

.status-row,
.field-item,
.note-input {
  border: 1px solid rgba(231, 192, 104, 0.58);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.045));
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.24);
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 18rpx;
  border-radius: 18rpx;
}

.status-label,
.status-picker {
  font-size: 26rpx;
}

.status-picker {
  color: #f2cf83;
}

.section {
  padding: 28rpx 24rpx 0;
}

.section-head {
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
}

.section-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.68);
}

.field-list {
  display: grid;
  gap: 14rpx;
}

.field-item {
  padding: 18rpx;
  border-radius: 18rpx;
}

.field-label,
.field-value {
  display: block;
}

.field-label {
  font-size: 22rpx;
  color: #f2cf83;
}

.field-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.45;
}

.note-input {
  width: 100%;
  min-height: 190rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.placeholder {
  color: rgba(255, 255, 255, 0.42);
}

.save-btn,
.action-primary,
.action-ghost {
  height: 82rpx;
  border: 1px solid rgba(231, 192, 104, 0.72);
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.save-btn::after,
.action-primary::after,
.action-ghost::after {
  border: 0;
}

.save-btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #8a5d20 0%, #d3ad5d 52%, #8f6226 100%);
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.action-primary {
  background: linear-gradient(135deg, #8a5d20 0%, #d3ad5d 52%, #8f6226 100%);
}

.action-ghost {
  background: rgba(255, 255, 255, 0.06);
}
