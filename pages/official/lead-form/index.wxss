page {
  background: #050403;
  color: #fff;
  padding-bottom: calc(env(safe-area-inset-bottom) + 130rpx);
}

.page,
.page view,
.page text,
.page input,
.page textarea,
.page button {
  box-sizing: border-box;
  color: #fff;
}

.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 14% 0%, rgba(216, 174, 87, 0.16), transparent 34%),
    linear-gradient(180deg, #0b0906 0%, #050403 54%, #090806 100%);
}

.load-state {
  min-height: 72vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  text-align: center;
}

.load-title {
  font-size: 34rpx;
  font-weight: 700;
}

.load-desc {
  max-width: 560rpx;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 25rpx;
  line-height: 1.6;
}

.retry-btn {
  min-width: 220rpx;
  margin-top: 30rpx;
  border: 1px solid rgba(231, 192, 104, 0.72);
  border-radius: 16rpx;
  background: #9a6b29;
  font-size: 26rpx;
}

.retry-btn::after {
  border: 0;
}

.hero {
  padding: 42rpx 28rpx 24rpx;
}

.eyebrow {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border: 1px solid rgba(231, 192, 104, 0.66);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  font-size: 22rpx;
}

.title {
  margin-top: 28rpx;
  font-size: 52rpx;
  line-height: 1.14;
  font-weight: 700;
}

.subtitle {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.58;
  color: rgba(255, 255, 255, 0.76);
}

.form-card,
.notice {
  margin: 20rpx 24rpx 0;
  border: 1px solid rgba(231, 192, 104, 0.58);
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.045));
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.28);
}

.form-card {
  padding: 22rpx;
}

.field + .field {
  margin-top: 22rpx;
}

.field-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.required {
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(211, 173, 93, 0.18);
  color: #f2cf83;
  font-size: 20rpx;
  font-weight: 500;
}

.field-control {
  width: 100%;
  min-height: 82rpx;
  padding: 0 20rpx;
  border: 1px solid rgba(231, 192, 104, 0.5);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.07);
  font-size: 27rpx;
}

.textarea {
  min-height: 160rpx;
  padding: 18rpx 20rpx;
  line-height: 1.5;
}

.picker-value {
  display: flex;
  align-items: center;
}

.choice-group {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.choice-item {
  min-height: 74rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx;
  border: 1px solid rgba(231, 192, 104, 0.5);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.07);
  font-size: 25rpx;
}

.placeholder,
.placeholder-text {
  color: rgba(255, 255, 255, 0.44);
}

.notice {
  padding: 18rpx 20rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.62);
}

.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: rgba(5, 4, 3, 0.92);
  border-top: 1px solid rgba(231, 192, 104, 0.42);
}

.submit-btn {
  height: 86rpx;
  border: 1px solid rgba(231, 192, 104, 0.72);
  border-radius: 18rpx;
  background: linear-gradient(135deg, #8a5d20 0%, #d3ad5d 52%, #8f6226 100%);
  font-size: 29rpx;
  font-weight: 700;
}

.submit-btn::after {
  border: 0;
}

/* Gold marks actions; silver marks read-only information. */
.eyebrow,
.form-card,
.notice {
  border-color: rgba(190, 201, 214, 0.48);
}

.field-control,
.choice-item,
.retry-btn,
.submit-btn {
  border-color: rgba(239, 199, 105, 0.92);
  border-width: 2rpx;
  box-shadow: 0 0 0 1rpx rgba(239, 199, 105, 0.06);
}
