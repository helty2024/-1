page {
  background: #050403;
  color: #fff;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

.page,
.page view,
.page text,
.page button {
  box-sizing: border-box;
  color: #fff;
}

.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 14% 0%, rgba(216, 174, 87, 0.16), transparent 34%),
    linear-gradient(180deg, #0b0906 0%, #050403 54%, #090806 100%);
}

.hero {
  padding: 42rpx 28rpx 24rpx;
}

.eyebrow {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border: 1px solid rgba(231, 192, 104, 0.66);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  font-size: 22rpx;
}

.title {
  margin-top: 28rpx;
  font-size: 54rpx;
  line-height: 1.14;
  font-weight: 700;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.58;
  color: rgba(255, 255, 255, 0.76);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.summary-card,
.filter-control,
.lead-card,
.empty {
  border: 1px solid rgba(231, 192, 104, 0.58);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.045));
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.24);
}

.summary-card {
  min-height: 110rpx;
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
}

.summary-value,
.summary-label,
.lead-type,
.lead-status,
.lead-name,
.lead-desc,
.lead-time,
.empty-title,
.empty-desc {
  display: block;
}

.summary-value {
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 700;
}

.summary-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.68);
}

.filters {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  padding: 0 24rpx 20rpx;
}

.filter-control {
  height: 74rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
}

.lead-list {
  display: grid;
  gap: 16rpx;
  padding: 0 24rpx;
}

.lead-card,
.empty {
  border-radius: 20rpx;
  padding: 20rpx;
}

.lead-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.lead-type {
  font-size: 24rpx;
  color: #f2cf83;
}

.lead-status {
  flex: none;
  padding: 6rpx 10rpx;
  border: 1px solid rgba(231, 192, 104, 0.46);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
}

.status-qualified {
  color: #f2cf83;
}

.lead-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.28;
  font-weight: 700;
}

.lead-desc,
.lead-time,
.empty-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.68);
}

.empty {
  margin: 16rpx 24rpx 0;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
}

.empty-btn {
  margin-top: 18rpx;
  height: 78rpx;
  border: 1px solid rgba(231, 192, 104, 0.72);
  border-radius: 16rpx;
  background: linear-gradient(135deg, #8a5d20 0%, #d3ad5d 52%, #8f6226 100%);
  font-size: 27rpx;
  font-weight: 700;
}

.empty-btn::after {
  border: 0;
}
