<view class="loading-state" wx:if="{{loading}}">正在加载合作内容...</view>

<view class="page" wx:if="{{content}}">
  <view class="hero">
    <image class="hero-bg" src="{{heroImage}}" mode="aspectFill" />
    <view class="hero-overlay"></view>
    <view class="hero-content">
      <view class="eyebrow">{{content.label}}</view>
      <view class="brand">{{content.title}}</view>
      <view class="subtitle">{{content.subtitle}}</view>
      <view class="hero-stats" wx:if="{{content.stats && content.stats.length}}">
        <view class="stat" wx:for="{{content.stats}}" wx:key="label">
          <text class="stat-value">{{item.value}}</text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{overviewSection}}">
    <view class="section-head">
      <text class="section-title">{{overviewSection.title}}</text>
      <text class="section-sub">{{overviewSection.body}}</text>
    </view>
    <image wx:if="{{overviewSection.image}}" class="section-image" src="{{overviewSection.image}}" mode="aspectFill" />
    <view class="card-grid">
      <view class="info-card" wx:for="{{overviewSection.cards}}" wx:key="title">
        <text class="info-title">{{item.title}}</text>
        <text class="info-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{benefitSection}}">
    <view class="section-head">
      <text class="section-title">{{benefitSection.title}}</text>
      <text class="section-sub">{{benefitSection.body}}</text>
    </view>
    <image wx:if="{{benefitSection.image}}" class="section-image" src="{{benefitSection.image}}" mode="aspectFill" />
    <view class="card-grid">
      <view class="benefit-card" wx:for="{{benefitSection.cards}}" wx:key="title">
        <text class="benefit-title">{{item.title}}</text>
        <text class="benefit-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{directionSection}}">
    <view class="section-head">
      <text class="section-title">{{directionSection.title}}</text>
      <text class="section-sub">{{directionSection.body}}</text>
    </view>
    <image wx:if="{{directionSection.image}}" class="section-image" src="{{directionSection.image}}" mode="aspectFill" />
    <view class="application-grid">
      <view
        class="application-card {{item.url ? 'is-interactive' : 'is-readonly'}}"
        hover-class="interactive-hover"
        wx:for="{{directionSection.cards}}"
        wx:key="title"
        data-url="{{item.url}}"
        data-tab="{{item.tab}}"
        bindtap="handleAction"
      >
        <text class="application-title">{{item.title}}</text>
        <text class="application-desc">{{item.desc}}</text>
        <text class="application-link" wx:if="{{item.url}}">{{item.actionText || '查看详情'}}</text>
      </view>
    </view>
  </view>
</view>
