page {
  box-sizing: border-box;
  background: #f4efe6;
  color: #1f1a16;
  padding-bottom: calc(env(safe-area-inset-bottom) + 110rpx);
}

.page {
  min-height: 100vh;
}

.hero {
  position: relative;
  overflow: hidden;
  min-height: 760rpx;
  padding: 36rpx 28rpx 40rpx;
  color: #fff7e8;
  background: #1f160e;
}

.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  filter: brightness(1.06) saturate(1.03);
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(24, 16, 10, 0.12) 0%, rgba(24, 16, 10, 0.42) 58%, rgba(24, 16, 10, 0.68) 100%),
    linear-gradient(135deg, rgba(133, 83, 33, 0.1) 0%, rgba(47, 30, 18, 0.03) 48%, rgba(17, 12, 9, 0.36) 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border: 1px solid rgba(231, 192, 104, 0.58);
  border-radius: 999rpx;
  background: rgba(255, 240, 214, 0.08);
  font-size: 22rpx;
  text-shadow: 0 2rpx 8rpx rgba(18, 12, 8, 0.28);
}

.brand {
  margin-top: 28rpx;
  font-size: 72rpx;
  line-height: 1;
  font-weight: 700;
  text-shadow: 0 4rpx 16rpx rgba(18, 12, 8, 0.34);
}

.subtitle {
  margin-top: 18rpx;
  max-width: 620rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: rgba(255, 246, 229, 0.88);
  text-shadow: 0 3rpx 12rpx rgba(18, 12, 8, 0.32);
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  border: 0;
  font-size: 28rpx;
  font-weight: 600;
}

.btn::after {
  border: 0;
}

.btn-primary {
  color: #1c120a;
  background: linear-gradient(135deg, #f3c97a 0%, #f9e6bf 100%);
}

.btn-ghost {
  color: #fff7e8;
  background: rgba(255, 247, 235, 0.08);
  border: 1px solid rgba(231, 192, 104, 0.52);
}

.section {
  padding: 28rpx 24rpx 0;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #201812;
}

.section-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6f6257;
}

.card-grid,
.cta-card {
  display: grid;
  gap: 16rpx;
}

.info-card,
.benefit-card,
.cta-card {
  border-radius: 22rpx;
  background: #fff;
  border: 1px solid rgba(231, 192, 104, 0.38);
  box-shadow: 0 18rpx 50rpx rgba(33, 24, 15, 0.05);
}

.info-card,
.benefit-card {
  padding: 18rpx;
}

.info-title,
.benefit-title,
.cta-title {
  display: block;
  font-weight: 700;
  color: #22180f;
  font-size: 30rpx;
}

.info-desc,
.benefit-desc,
.cta-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6d5f55;
}

.cta-card {
  padding: 22rpx;
  margin-bottom: 24rpx;
}

.cta-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

@media screen and (min-width: 760px) {
  .hero,
  .section {
    padding-left: 40rpx;
    padding-right: 40rpx;
  }

  .card-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

page {
  background: #050403;
  color: #fff;
}

.page,
.page view,
.page text,
.page button {
  color: #fff;
}

.page {
  background:
    radial-gradient(circle at 88% 0%, rgba(225, 178, 87, 0.13), transparent 32%),
    linear-gradient(180deg, #0b0906 0%, #050403 50%, #090806 100%);
}

.hero {
  background: #050403;
}

.hero-bg {
  filter: brightness(0.94) saturate(1.04);
}

.hero-overlay {
  background:
    linear-gradient(180deg, rgba(5, 4, 3, 0.18) 0%, rgba(5, 4, 3, 0.46) 58%, rgba(5, 4, 3, 0.82) 100%),
    linear-gradient(135deg, rgba(214, 171, 83, 0.18) 0%, rgba(5, 4, 3, 0.1) 48%, rgba(5, 4, 3, 0.48) 100%);
}

.eyebrow {
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(231, 192, 104, 0.28);
}

.section-title,
.info-title,
.benefit-title,
.cta-title {
  color: #fff;
}

.subtitle,
.section-sub,
.info-desc,
.benefit-desc,
.cta-desc {
  color: rgba(255, 255, 255, 0.78);
}

.info-card,
.benefit-card,
.cta-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.045));
  border-color: rgba(231, 192, 104, 0.22);
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.28);
}

.btn-primary {
  color: #fff;
  background: linear-gradient(135deg, #8a5d20 0%, #d3ad5d 52%, #8f6226 100%);
  box-shadow: 0 12rpx 30rpx rgba(194, 145, 55, 0.22);
}

.btn-ghost {
  color: #fff;
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(231, 192, 104, 0.28);
}

.eyebrow,
.info-card,
.benefit-card,
.cta-card,
.btn {
  border-color: rgba(231, 192, 104, 0.58);
}

.btn {
  border-width: 1px;
  border-style: solid;
}
