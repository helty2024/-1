# 复制为 infra/env/.env.production 后再填写。该正式配置文件不会提交到 Git。
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
ADMIN_WEB_ORIGIN=https://example.com
SWAGGER_ENABLED=false
TRUST_PROXY_HOPS=1

HTTP_PORT=80
HTTPS_PORT=443

MYSQL_ROOT_PASSWORD=replace-with-random-root-password
DATABASE_URL=mysql://zhishentang:replace-with-uri-safe-db-password@mysql:3306/zhishentang
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=zhishentang
DATABASE_PASSWORD=replace-with-uri-safe-db-password
DATABASE_NAME=zhishentang
DATABASE_CONNECTION_LIMIT=10
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=true

REDIS_ENABLED=true
REDIS_PASSWORD=replace-with-random-redis-password
REDIS_URL=redis://:replace-with-random-redis-password@redis:6379

PUBLIC_FORM_RATE_WINDOW_SECONDS=600
PUBLIC_FORM_RATE_IP_MAX=20
PUBLIC_FORM_RATE_FORM_IP_MAX=6
PUBLIC_FORM_MAX_BODY_BYTES=32768
PUBLIC_FORM_ALLOWED_SOURCES=wechat_miniprogram,web

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-for-jwt
JWT_ACCESS_EXPIRES_IN=2h
APP_DATA_ENCRYPTION_KEY=replace-with-another-32-random-characters-for-data

# 仅首次初始化使用，首次登录后应立即在后台修改密码。
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=replace-with-strong-first-login-password
ADMIN_SEED_DISPLAY_NAME=超级管理员

# 正式环境推荐 cos；暂未开通 COS 时可先使用 local。
MEDIA_STORAGE_DRIVER=cos
MEDIA_STORAGE_DIR=storage/media
MEDIA_TEMP_DIR=storage/tmp/media
MEDIA_MAX_FILE_SIZE_BYTES=20971520
MEDIA_PUBLIC_BASE_URL=https://example.com/media
COS_SECRET_ID=replace-with-tencent-cloud-secret-id
COS_SECRET_KEY=replace-with-tencent-cloud-secret-key
COS_BUCKET=replace-with-complete-bucket-name-appid
COS_REGION=ap-beijing
# 留空时使用腾讯云默认 COS 域名。
COS_PUBLIC_BASE_URL=

LOG_LEVEL=info
LOG_PRETTY=false
